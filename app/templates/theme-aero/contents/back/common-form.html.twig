{% extends '@App/theme-aero/bases/back/full.html.twig' %}

{% block content %}

{% if app.current_route ends with 'create' %}
    {% set title = 'text.item.create'|trans %}
    {% set delete = null %}
{% else %}
    {% set title = 'text.item.update'|trans %}
    {% set delete = include('@App/partials/form-delete.html.twig') %}
{% endif %}

<!-- Main Content -->
<section class="content">
    <div class="block-header">
        <div class="row">
            <div class="col-lg-7 col-md-6 col-sm-12">
                <h2>Dashboard</h2>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('admin.dashboard.index') }}"><i class="zmdi zmdi-home"></i> {{ metas.title }}</a></li>
                    <li class="breadcrumb-item active">{{ 'text.dashboard'|trans }}</li>
                </ul>
                <button class="btn btn-primary btn-icon mobile_menu" type="button"><i class="zmdi zmdi-sort-amount-desc"></i></button>
            </div>
            <div class="col-lg-5 col-md-6 col-sm-12">
                <button class="btn btn-primary btn-icon float-right right_icon_toggle_btn" type="button"><i class="zmdi zmdi-arrow-right"></i></button>
            </div>
        </div>
    </div>
    <div class="container-fluid">
        <div class="row bg-secondary">
    <div class="col-10">
        <!-- Start Form -->
        {{ form_start(form) }}
        <div class="card">
            <div class="card-header">
                <h2 class="display-5">{{ title }}</h2>
            </div>
            <div class="card-body">
                {{ form_widget(form) }}
            </div>
            <div class="card-footer">
                <button class="{{ classes.button.success }} rounded-top-0 rounded-4 w-100">
                    {{ button_label|default('btn.register'|trans) }}
                </button>
            </div>
        </div>
        {{ form_end(form) }}
        <!-- End Form -->
    </div>
    <div class="col-2">
        <div class="sticky-top">
            <h6 class="h4">{{ 'text.action'|trans }}</h6>
            <a href="{{ path(links.index) }}" class="{{ classes.button.back }} mb-3 w-100">
                {{ 'btn.back'|trans }}
            </a>
            {{ delete|raw }}
        </div>
    </div>
</div>
    </div>
</section>

{% endblock %}
