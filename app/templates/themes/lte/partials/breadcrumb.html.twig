
<!--begin::Row-->
<div class="row">
    <div class="col-6">
        <span class="breadcrumb">{{ controller_name|trim }}</span>
    </div>
    <div class="col-6">
        <ol class="breadcrumb float-end">
        {% for item in breadcrumb %}
            {% if item.route is not empty %}
            <li class="breadcrumb-item">
                <a href="{{ path(item.route, item.params|default({})) }}">{{ item.label }}</a>
            </li>
            {% else %}
            <li class="breadcrumb-item active fw-bolder" aria-current="page">
                {{ item.label }}
            </li>
            {% endif %}
        {% endfor %}
        </ol>
    </div>
</div>
<!--end::Row-->
