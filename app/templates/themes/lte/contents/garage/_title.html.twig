
{% from "@App/themes/lte/contents/garage/_macros.html.twig" import getStars, getClass %}

<div class="card border border-opacity-50 border-white border-1 shadow-sm {{ background }}">
    <div class="card-header border-bottom-0 py-0 {{ text }}">
        <h1 class="titillium-web-bold fw-bolder display-1 title-premium"><span class=" display-3">{{ entity.settingBrand.name }}&nbsp;</span>{{ entity.model }}</h1>
    </div>
    <div class="card-body">
        <div class="row row-cols-3">
            <div class="col-auto">
                <div class="class-box">
                    <div class="class-box-content">
                      <span class="class-box-label text-center text-white">{{ 'text.class'|trans }}</span>
                      <span class="text-center rubik-mono-one-regular display-2 {{ text }}">{{ entity.settingClass.value }}</span>
                    </div>
                </div>
            </div>
            <div class="col-auto">
                <div class="info-box stars mt-4">
                    <div class="info-box-content">
                        <span class="class-box-label text-start text-white">{{ 'text.stars'|trans }}</span>
                        <span class="">{{ getStars(entity, text) }}</span>
                    </div>
                </div>
            </div>
            <div class="col-auto">
                <div class="info-box stars mt-4">
                    <div class="info-box-content">
                        <span class="d-block class-box-label text-start text-white">Mode</span>
                        <div class="btn-group" role="list" aria-label="Display Mode">
                            <input type="radio" class="btn-check" name="mode" id="full" value="full" autocomplete="off"{% if mode is defined and mode == 'full' %} checked{% endif %}>
                            <label class="btn btn-outline-primary" for="full">Full</label>
                            <input type="radio" class="btn-check" name="mode" id="light" value="light" autocomplete="off"{% if mode is defined and mode == 'light' %} checked{% endif %}>
                            <label class="btn btn-outline-primary" for="light">Light</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
