{% extends '@App/themes/lte/contents/commons/page-index.html.twig' %}

{% block table %}
    <tbody>
    {% for item in entities %}
        <tr>
            <td class="my-0 py-0 align-middle text-center">{{ loop.index }}</td>
            <td class="my-0 py-0 align-middle text-center">{{ item.gameUpdate }}</td>
            <td class="my-0 py-0 align-middle text-center">{{ item.class_value }}</td>
            <td class="my-0 py-0 align-middle text-start">
                <a
                    href="{{ path('app.garage.update', {id: item.id, slug: item.slug}) }}"
                    class="text-decoration-none {{ _self.color(item) }}"
                    target="_blank"
                >
                    {{ item.brand }}
                </a>
            </td>
            <td class="my-0 py-0 align-middle text-start">
                <a
                    href="{{ path('app.garage.update', {id: item.id, slug: item.slug}) }}"
                    class="text-decoration-none {{ _self.color(item) }}"
                    target="_blank"
                >
                    {{ item.model }}
                </a>
            </td>
            <td class="my-0 py-0 align-middle text-center"><twig:TableBoolean value="{{ item.status_unblock|default(false) }}" /></td>
            <td class="my-0 py-0 align-middle text-center"><twig:TableBoolean value="{{ item.status_gold|default(false) }}" /></td>
            <td class="my-0 py-0 align-middle text-center"><twig:TableBoolean value="{{ item.status_to_upgrade|default(false) }}" /></td>
            <td class="my-0 py-0 align-middle text-end">
                <div class="btn-group no-padding" role="group" aria-label="{{ 'text.action'|trans }}">
                    <a
                        href="{{ path('app.garage.read', {'id': item.id, 'slug': item.slug}) }}"
                        class="{{ classes.button.table }} btn-outline-warning"
                        target="_blank"
                    >
                        <span class="d-md-none d-lg-inline-block">{{ 'btn.read'|trans }}&nbsp;</span>
                        <i class="fa-solid fa-file"></i>
                    </a>
                    <a
                        href="{{ path('app.garage.update', {'id': item.id, 'slug': item.slug}) }}"
                        class="{{ classes.button.table }} btn-outline-info"
                        target="_blank"
                    >
                        <i class="fa-solid fa-pencil"></i>
                        <span class="d-md-none d-lg-inline-block">&nbsp;{{ 'btn.update'|trans }}</span>
                    </a>
                </div>
            </td>
        </tr>
    {% else %}
        <twig:TableEmpty value="{{ 9 }}" />
    {% endfor %}
    </tbody>
    <thead>
        {{ _self.legend() }}
    </thead>
    <tfoot>
        {{ _self.legend() }}
    </tfoot>
{% endblock %}

{% block tableId %}
    {% if current_page == 'app.garage.index' %} id="Garage"{% endif %}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {% if app.environment == 'dev' %}
    <link rel="stylesheet" href="{{ asset('libraries/bootstrap-table/1.27/dist/bootstrap-table.css') }}">
    {% else %}
    <link rel="stylesheet" href="{{ asset('libraries/bootstrap-table/1.27/dist/bootstrap-table.min.css') }}">
    {% endif %}
{% endblock %}

{% macro legend() %}
    <tr>{#  class="sticky-top" #}
        <th class="col-auto text-center">&nbsp;</th>
        <th class="col-1 text-center" data-sortable="true">{{ 'text.game.update'|trans }}</th>
        <th class="col-1 text-center">{{ 'text.class'|trans }}</th>
        <th class="col-auto text-start" data-sortable="true">{{ 'text.brand'|trans }}</th>
        <th class="col-auto text-start" data-sortable="true">{{ 'text.model'|trans }}</th>
        <th class="col-1 text-center text-success">{{ 'text.unblock'|trans }}</th>
        <th class="col-1 text-center text-warning">{{ 'text.gold'|trans }}</th>
        <th class="col-1 text-center text-info">{{ 'text.to.upgrade'|trans }}</th>
        <th class="col-auto text-end">{{ 'text.action'|trans }}</th>
    </tr>
{% endmacro %}

{% macro color(entity) %}
    {% if entity.status_unblock == true and entity.status_gold == true %}
        text-warning
    {% elseif entity.status_unblock == true %}
        text-success
    {% elseif entity.status_to_upgrade == true %}
        text-info
    {% else %}
        text-danger
    {% endif %}
{% endmacro %}
