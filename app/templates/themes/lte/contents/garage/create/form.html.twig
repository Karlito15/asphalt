
<section class="{{ container|default('container') }} mb-2 px-0">

    <div class="row row-cols-2">
        <div class="col">
            <div class="form-floating">
                {{ form_widget(form.settingBrand) }}
                {{ form_label(form.settingBrand) }}
            </div>
        </div>
        <div class="col">
            <div class="form-floating">
                {{ form_widget(form.model) }}
                {{ form_label(form.model) }}
            </div>
        </div>
    </div>

    <div class="row row-cols-3 mt-5">
        <div class="col">
            <div class="form-floating">
                {{ form_widget(form.settingClass) }}
                {{ form_label(form.settingClass) }}
            </div>
        </div>
        <div class="col">
            <div class="form-floating">
                {{ form_widget(form.stars) }}
                {{ form_label(form.stars) }}
            </div>
        </div>
        <div class="col">
            <div class="form-floating">
                {{ form_widget(form.gameUpdate, {'attr': {'value': game_update_last}}) }}
                {{ form_label(form.gameUpdate) }}
            </div>
        </div>
{#        {{ form_row(form.gameUpdate, {'attr': {'value': game_update_last}}) }}#}
    </div>

</section>

