
<div class="card border border-opacity-50 border-white border-1 shadow-sm {{ background }} d-block" id="full">
    <div class="card-header border-bottom-0">
        {{ 'text.garage'|trans }}
    </div>
    <div class="card-body">
        <div class="row row-cols-2 row-gap-3">
            <div class="col">
                {{ form_label(form.level) }}
                <div class="input-group">
                    {{ form_widget(form.level) }}
                    <label for="maxLevel"></label>
                    <input
                        type="text"
                        id="maxLevel"
                        class="form-control text-center text-info"
                        value="{{ entity.settingLevel.level }}"
                        readonly
                    />
                </div>
            </div>
            <div class="col">
                {{ form_label(form.epic) }}
                <div class="input-group">
                    {{ form_widget(form.epic) }}
                    <label for="maxEpic"></label>
                    <input
                        type="text"
                        id="maxEpic"
                        class="form-control text-center text-info"
                        value="{{ entity.settingLevel.epic }}"
                        readonly
                    />
                </div>
            </div>
        </div>
    </div>
</div>
