
<div class="card border border-opacity-25 border-white border-1 shadow-sm {{ background }}">
    <div class="card-header border-bottom-0 py-1 px-2 fs-1">
        <span class="">{{ 'text.stat'|trans|plural }}</span>
        <span class="badge rounded-pill bg-danger">
            <i class="fa-solid fa-fire"></i>&nbsp;{{ entity.settingClass.median }}
        </span>
    </div>
    <div class="card-body py-1 px-2">

        <div class="card-body gradient">

            <div class="d-flex justify-content-around">
                <div class="col fw-bolder text-start">
                    &nbsp;
                </div>
                <div class="col fw-bolder text-end">
                    {{ 'text.stat.min'|trans }}
                </div>
                <div class="col fw-bolder text-end">
                    {{ 'text.stat.max'|trans }}
                </div>
                <div class="col fw-bolder text-end">
                    {{ 'text.stat.actual'|trans }}
                </div>
            </div>

            <div class="d-flex justify-content-around align-items-center">
                <div class="col">⚡</div>
                <twig:FormControl target="Stat" form="{{ form.statMin.speed }}" />
                <twig:FormControl target="Stat" form="{{ form.statMax.speed }}" />
                <twig:FormControl target="Stat" form="{{ form.statActual.speed }}" />
            </div>

            <div class="d-flex justify-content-around align-items-center">
                <div class="col">🚀</div>
                <twig:FormControl target="Stat" form="{{ form.statMin.acceleration }}" />
                <twig:FormControl target="Stat" form="{{ form.statMax.acceleration }}" />
                <twig:FormControl target="Stat" form="{{ form.statActual.acceleration }}" />
            </div>

            <div class="d-flex justify-content-around align-items-center">
                <div class="col">🎯</div>
                <twig:FormControl target="Stat" form="{{ form.statMin.handling }}" />
                <twig:FormControl target="Stat" form="{{ form.statMax.handling }}" />
                <twig:FormControl target="Stat" form="{{ form.statActual.handling }}" />
            </div>

            <div class="d-flex justify-content-around align-items-center">
                <div class="col">🔥</div>
                <twig:FormControl target="Stat" form="{{ form.statMin.nitro }}" />
                <twig:FormControl target="Stat" form="{{ form.statMax.nitro }}" />
                <twig:FormControl target="Stat" form="{{ form.statActual.nitro }}" />
            </div>

            <div class="d-flex justify-content-around align-items-center">
                <div class="col fw-bolder text-start">{{ 'text.average'|trans }}</div>
                <div class="col fw-bolder text-end">
                    <span class="black-ops-one-regular fs-5 text-end fw-bolder">{{ entity.statMin.average|number_format('2', ',', ' ') }}</span>
                </div>
                <div class="col fw-bolder text-end">
                    <span class="black-ops-one-regular fs-5 text-end fw-bolder">{{ entity.statMax.average|number_format('2', ',', ' ') }}</span>
                </div>
                <div class="col fw-bolder text-end">
                    <span class="black-ops-one-regular fs-5 text-end fw-bolder">{{ entity.statActual.average|number_format('2', ',', ' ') }}</span>
                </div>
            </div>

        </div>

    </div>
</div>
