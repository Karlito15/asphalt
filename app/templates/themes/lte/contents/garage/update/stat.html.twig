
<div class="card border border-opacity-50 border-white border-1 shadow-sm {{ background }} d-none" id="light">
    <div class="card-header border-bottom-0">
        <span class="float-start">{{ 'text.stat'|trans|plural }}</span>
        <span class="float-end badge rounded-pill bg-danger">
            <i class="fa-solid fa-fire"></i>&nbsp;{{ entity.settingClass.median }}
        </span>
    </div>
    <div class="card-body">
        <div class="d-flex justify-content-around">
            <div class="col-3 text-start">
                <label for="">
                    <input
                        type="text"
                        autocomplete="off"
                        class="form-control-plaintext form-control-sm form-control"
                        value="{{ 'text.legend'|trans }}"
                        readonly
                    />
                </label>
            </div>
            <div class="col-3 text-end">
                {{ 'text.stat.min'|trans }}
            </div>
            <div class="col-3 text-end">
                {{ 'text.stat.max'|trans }}
            </div>
            <div class="col-3 text-end">
                {{ 'text.stat.actual'|trans }}
            </div>
        </div>

        <div class="d-flex justify-content-around">
            <div class="col-3 text-start">
                <label for="">
                    <input
                        type="text"
                        autocomplete="off"
                        class="form-control-plaintext form-control-sm form-control"
                        value="{{ 'text.speed'|trans }}"
                        readonly
                    />
                </label>
            </div>
            <div class="col-3 text-end">
                <twig:UpdaterStat
                    entity="{{ entity.statMin }}"
                    formulaire="{{ form.statMin.speed }}"
                />
            </div>
            <div class="col-3 text-end">
                <twig:UpdaterStat
                    entity="{{ entity.statMax }}"
                    formulaire="{{ form.statMax.speed }}"
                />
            </div>
            <div class="col-3 text-end">
                <twig:UpdaterStat
                    entity="{{ entity.statActual }}"
                    formulaire="{{ form.statActual.speed }}"
                />
            </div>
        </div>

        <div class="d-flex justify-content-around">
            <div class="col-3 text-start text-nowrap">
                <label for="">
                    <input
                        type="text"
                        autocomplete="off"
                        class="form-control-plaintext form-control-sm form-control"
                        value="{{ 'text.acceleration'|trans }}"
                        readonly
                    />
                </label>
            </div>
            <div class="col-3 text-end">
                <twig:UpdaterStat
                    entity="{{ entity.statMin }}"
                    formulaire="{{ form.statMin.acceleration }}"
                />
            </div>
            <div class="col-3 text-end">
                <twig:UpdaterStat
                    entity="{{ entity.statMax }}"
                    formulaire="{{ form.statMax.acceleration }}"
                />
            </div>
            <div class="col-3 text-end">
                <twig:UpdaterStat
                    entity="{{ entity.statActual }}"
                    formulaire="{{ form.statActual.acceleration }}"
                />
            </div>
        </div>

        <div class="d-flex justify-content-around">
            <div class="col-3 text-start">
                <label for="">
                    <input
                        type="text"
                        autocomplete="off"
                        class="form-control-plaintext form-control-sm form-control"
                        value="{{ 'text.handling'|trans }}"
                        readonly
                    />
                </label>
            </div>
            <div class="col-3 text-end">
                <twig:UpdaterStat
                    entity="{{ entity.statMin }}"
                    formulaire="{{ form.statMin.handling }}"
                />
            </div>
            <div class="col-3 text-end">
                <twig:UpdaterStat
                    entity="{{ entity.statMax }}"
                    formulaire="{{ form.statMax.handling }}"
                />
            </div>
            <div class="col-3 text-end">
                <twig:UpdaterStat
                    entity="{{ entity.statActual }}"
                    formulaire="{{ form.statActual.handling }}"
                />
            </div>
        </div>

        <div class="d-flex justify-content-around">
            <div class="col-3 text-start">
                <label for="">
                    <input
                        type="text"
                        autocomplete="off"
                        class="form-control-plaintext form-control-sm form-control"
                        value="{{ 'text.nitro'|trans }}"
                        readonly
                    />
                </label>
            </div>
            <div class="col-3 text-end">
                <twig:UpdaterStat
                    entity="{{ entity.statMin }}"
                    formulaire="{{ form.statMin.nitro }}"
                />
            </div>
            <div class="col-3 text-end">
                <twig:UpdaterStat
                    entity="{{ entity.statMax }}"
                    formulaire="{{ form.statMax.nitro }}"
                />
            </div>
            <div class="col-3 text-end">
                <twig:UpdaterStat
                    entity="{{ entity.statActual }}"
                    formulaire="{{ form.statActual.nitro }}"
                />
            </div>
        </div>

        <div class="d-flex justify-content-around">
            <div class="col-3 text-start">
                <label for="">
                    <input
                        type="text"
                        autocomplete="off"
                        class="form-control-plaintext form-control-sm form-control"
                        value="{{ 'text.average'|trans }}"
                        readonly
                    />
                </label>
            </div>
            <div class="col-3 text-end">
                <label for="">
                    <input
                        type="text"
                        autocomplete="off"
                        class="form-control-plaintext form-control-sm text-end form-control"
                        value="{{ entity.statMin.average|number_format('2', ',', ' ') }}"
                        readonly
                    />
                </label>
            </div>
            <div class="col-3 text-end">
                <label for="">
                    <input
                        type="text"
                        autocomplete="off"
                        class="form-control-plaintext form-control-sm text-end form-control"
                        value="{{ entity.statMax.average|number_format('2', ',', ' ') }}"
                        readonly
                    />
                </label>
            </div>
            <div class="col-3 text-end">
                <label for="">
                    <input
                        type="text"
                        autocomplete="off"
                        class="form-control-plaintext form-control-sm text-end form-control"
                        value="{{ entity.statActual.average|number_format('2', ',', ' ') }}"
                        readonly
                    />
                </label>
            </div>
        </div>
    </div>
</div>
