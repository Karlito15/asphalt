
<div class="card border border-opacity-25 border-white border-1 shadow-sm {{ background }}">
    <div class="card-header border-bottom-0 py-1 px-2 fs-1">{{ 'text.rank'|trans }}</div>
    <div class="card-body py-1 px-2">
        <div class="row">
            <twig:FormFloating column="{{ 1 }}" form="{{ form.rank.star0 }}" />
            <twig:FormFloating column="{{ 1 }}" form="{{ form.rank.star1 }}" />
            <twig:FormFloating column="{{ 1 }}" form="{{ form.rank.star2 }}" />
            <twig:FormFloating column="{{ 1 }}" form="{{ form.rank.star3 }}" />
            <twig:FormFloating column="{{ 1 }}" form="{{ form.rank.star4 }}" />
            <twig:FormFloating column="{{ 1 }}" form="{{ form.rank.star5 }}" />
            <twig:FormFloating column="{{ 1 }}" form="{{ form.rank.star6 }}" />
        </div>
    </div>
</div>
