
<div class="card border border-opacity-50 border-white border-1 shadow-sm {{ background }} d-none" id="light">
    <div class="card-header border-bottom-0">
        {{ 'text.rank'|trans|plural }}
    </div>
    <div class="card-body">
        <twig:UpdaterRank
            maxValue="{{ 3000 }}"
            title="{{ 'text.start'|trans }}"
            entity="{{ entity.rank }}"
            formulaire="{{ form.rank.star0.vars.form }}"
        />

        <twig:UpdaterRank
            maxValue="{{ 3000 }}"
            title="{{ 'text.star1'|trans }}"
            entity="{{ entity.rank }}"
            formulaire="{{ form.rank.star1.vars.form }}"
        />

        <twig:UpdaterRank
            maxValue="{{ 3000 }}"
            title="{{ 'text.star2'|trans }}"
            entity="{{ entity.rank }}"
            formulaire="{{ form.rank.star2.vars.form }}"
        />

        <twig:UpdaterRank
            maxValue="{{ 4000 }}"
            title="{{ 'text.star3'|trans }}"
            entity="{{ entity.rank }}"
            formulaire="{{ form.rank.star3.vars.form }}"
        />

        <twig:UpdaterRank
            maxValue="{{ 5000 }}"
            title="{{ 'text.star4'|trans|plural }}"
            entity="{{ entity.rank }}"
            formulaire="{{ form.rank.star4.vars.form }}"
        />

        <twig:UpdaterRank
            maxValue="{{ 6000 }}"
            title="{{ 'text.star5'|trans|plural }}"
            entity="{{ entity.rank }}"
            formulaire="{{ form.rank.star5.vars.form }}"
        />

        <twig:UpdaterRank
            maxValue="{{ 700 }}"
            title="{{ 'text.star6'|trans|plural }}"
            entity="{{ entity.rank }}"
            formulaire="{{ form.rank.star6.vars.form }}"
        />
    </div>
</div>
