{% set calcul = (entity.blueprint.total - entity.settingBlueprint.total) %}
{% set result = (calcul / games.pack_blueprint)|round(0, 'ceil') %}

{# INPUT CLASS #}
{% if result is defined and result == 0 %}
    {% set inputClass = 'black-ops-one-regular fs-4 input-group-text justify-content-center text-center fw-bolder bg-success-subtle text-success form-control form-control-sm' %}
{% elseif result is defined and entity.blueprint.total > 0 %}
    {% set inputClass = 'black-ops-one-regular fs-4 input-group-text justify-content-center text-center fw-bolder bg-primary-subtle text-primary form-control form-control-sm' %}
{% else %}
    {% set inputClass = 'black-ops-one-regular fs-4 input-group-text justify-content-center text-center fw-bolder bg-danger-subtle text-danger form-control form-control-sm' %}
{% endif %}

        <div class="row"{# attributes #}>
            <div class="col">
                <!-- component HTML -->
                <div class="text-center"><label class="fw-bold">{{ 'text.total'|trans }}</label></div>
                <div class="input-group mb-2">
                    <span class="{{ inputClass }}">{{ entity.blueprint.total }}</span>
                    <span class="{{ inputClass }}">{{ calcul }}</span>
                    <span class="{{ inputClass }}">{{ entity.settingBlueprint.total }}</span>
                </div>

                <div class="input-group input-group-sm">
                    <input
                        type="text"
                        id="blueprints"
                        class="text-center text-info form-control"
                        value="{{ (result * games.pack_price)|abs|number_format }} {{ 'text.token'|trans|plural|u.truncate(2, '.') }}"
                        disabled
                    />
                    <label for="blueprints"></label>
                    <label for="packs"></label>
                    <input
                        type="text"
                        id="packs"
                        class="text-center text-success form-control"
                        value="{{ result|abs }} {{ 'text.pack'|trans|plural }}"
                        disabled
                    />
                </div>
            </div>
        </div>
