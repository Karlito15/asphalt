
<div class="card border border-opacity-25 border-white border-1 shadow-sm {{ background }}">
    <div class="card-header border-bottom-0 py-1 px-2 fs-1 poppins-black">{{ 'text.cost'|trans|plural }}</div>
    <div class="card-body py-1 px-2">
        <table class="table table-striped table-bordered">
            <thead>
            <tr>
                <th class="w-25 text-start py-1">{{ 'text.level'|trans }}</th>
                <th class="w-25 text-end py-1">{{ 'text.price.paid'|trans }}</th>
                <th class="w-25 text-end py-1">{{ 'text.price.due'|trans }}</th>
                <th class="w-25 text-end py-1">{{ 'text.price.amount'|trans }}</th>
            </tr>
            </thead>
            <tr>
                <td class="w-25 text-start py-1">{{ 'text.level01'|trans }}</td>
                <td class="w-25 text-end py-1">{{ entity.paid.level01|number_format('0', '', ' ') }}</td>
                <td class="w-25 text-end py-1">{{ entity.due.level01|number_format('0', '', ' ') }}</td>
                <td class="w-25 text-end py-1">{{ entity.amount.level01|number_format('0', '', ' ') }}</td>
            </tr>
