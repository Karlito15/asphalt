            </tr>
            <tfoot>
            <tr>
                <th class="w-25 text-start py-1">{{ 'text.upgrade'|trans|plural }}</th>
                <th class="w-25 text-end py-1">{{ _self.subTotalUpgrade(entity.paid) }}</th>
                <th class="w-25 text-end py-1">{{ _self.subTotalUpgrade(entity.due) }}</th>
                <th class="w-25 text-end py-1">{{ _self.subTotalUpgrade(entity.amount) }}</th>
            </tr>
            <tr>
                <th class="w-25 text-start py-1">{{ 'text.import'|trans|plural }}</th>
                <th class="w-25 text-end py-1">{{ _self.subTotalImport(entity.paid) }}</th>
                <th class="w-25 text-end py-1">{{ _self.subTotalImport(entity.due) }}</th>
                <th class="w-25 text-end py-1">{{ _self.subTotalImport(entity.amount) }}</th>
            </tr>
            <tr>
                <th class="w-25 text-start py-1">{{ 'text.total'|trans }}</th>
                <th class="w-25 text-end py-1">{{ _self.total(entity.paid) }}</th>
                <th class="w-25 text-end py-1">{{ _self.total(entity.due) }}</th>
                <th class="w-25 text-end py-1">{{ _self.total(entity.amount) }}</th>
            </tr>
            </tfoot>
        </table>
    </div>
</div>

{% macro subTotalUpgrade(entity) %}
    {{ (entity.level01 + entity.level02 + entity.level03 + entity.level04 +
    entity.level05 + entity.level06 + entity.level07 + entity.level08 +
    entity.level09 + entity.level10 + entity.level11 + entity.level12 +
    entity.level13)|number_format('0', '', ' ') }}
{% endmacro %}

{% macro subTotalImport(entity) %}
    {{ (entity.common + entity.rare + entity.epic)|number_format('0', '', ' ') }}
{% endmacro %}

{% macro total(entity) %}
    {{ (entity.level01 + entity.level02 + entity.level03 + entity.level04 +
    entity.level05 + entity.level06 + entity.level07 + entity.level08 +
    entity.level09 + entity.level10 + entity.level11 + entity.level12 +
    entity.level13 + entity.common + entity.rare + entity.epic)|number_format('0', '', ' ')
 }}
{% endmacro %}
