
<div class="card border border-opacity-50 border-white border-1 shadow-sm {{ background }}">
    <div class="card-header border-bottom-0">
        {{ 'text.upgrade'|trans|plural }}
    </div>
    <div class="card-body">

        <twig:UpdaterUpgrade
            maxValue="{{ entity.level }}"
            title="{{ 'text.speed'|trans }}"
            icon="{{ icons.gauge }}"
            entity="{{ entity.upgrade }}"
            formulaire="{{ form.upgrade.speed.vars.form }}"
        />

        <twig:UpdaterUpgrade
            maxValue="{{ entity.level }}"
            title="{{ 'text.acceleration'|trans }}"
            icon="{{ icons.fire }}"
            entity="{{ entity.upgrade }}"
            formulaire="{{ form.upgrade.acceleration.vars.form }}"
        />

        <twig:UpdaterUpgrade
            maxValue="{{ entity.level }}"
            title="{{ 'text.handling'|trans }}"
            icon="{{ icons.gear }}"
            entity="{{ entity.upgrade }}"
            formulaire="{{ form.upgrade.handling.vars.form }}"
        />

        <twig:UpdaterUpgrade
            maxValue="{{ entity.level }}"
            title="{{ 'text.nitro'|trans }}"
            icon="{{ icons.rocket }}"
            entity="{{ entity.upgrade }}"
            formulaire="{{ form.upgrade.nitro.vars.form }}"
        />

        <twig:UpdaterUpgrade
            maxValue="{{ entity.settingLevel.common }}"
            title="{{ 'text.common'|trans|plural }}"
            icon="{{ null }}"
            entity="{{ entity.upgrade }}"
            formulaire="{{ form.upgrade.common.vars.form }}"
        />

        <twig:UpdaterUpgrade
            maxValue="{{ entity.settingLevel.rare }}"
            title="{{ 'text.rare'|trans|plural }}"
            icon="{{ null }}"
            entity="{{ entity.upgrade }}"
            formulaire="{{ form.upgrade.rare.vars.form }}"
        />

        <twig:UpdaterUpgrade
            maxValue="{{ entity.settingLevel.epic }}"
            title="{{ 'text.epic'|trans|plural }}"
            icon="{{ null }}"
            entity="{{ entity.upgrade }}"
            formulaire="{{ form.upgrade.epic.vars.form }}"
        />

    </div>
</div>
