
<div class="card border border-opacity-25 border-white border-1 shadow-sm {{ background }}">
    <div class="card-header border-bottom-0 py-1 px-2 fs-1">{{ 'text.upgrade'|trans|plural }}</div>
    <div class="card-body py-1 px-2">
{#        <twig:FormRange />#}

        <div class="text-start">
                {{ 'text.speed'|trans }}
                <output class="float-end badge text-bg-warning" id="speed_max">{{ entity.level }}</output>
                <output class="float-end badge text-bg-info me-3" id="speed_range">{{ form.upgrade.speed.vars.value ?? 0 }}</output>
                {{ form_widget(form.upgrade.speed, {
                    attr: {
                        'oninput': 'speed_range.value = this.value',
                        'max': entity.level
                    }
                }) }}
        </div>
        <div class="text-start">
                {{ 'text.acceleration'|trans }}
                <output class="float-end badge text-bg-warning" id="acceleration_max">{{ entity.level }}</output>
