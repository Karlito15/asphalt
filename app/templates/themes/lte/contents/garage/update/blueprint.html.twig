
<div class="card border border-opacity-25 border-white border-1 shadow-sm {{ background }}">
    <div class="card-header border-bottom-0 py-1 px-2 fs-1 poppins-black">{{ 'text.blueprint'|trans|plural }}</div>
    <div class="card-body py-1 px-2">

        <div class="row row-cols-2 mb-3">
            <div class="col-10">{% include '@App/themes/lte/contents/garage/update/blueprint-stars.html.twig' with {'background': background, 'text': text} %}</div>
            <div class="col-2">{% include '@App/themes/lte/contents/garage/update/blueprint-total.html.twig' with {'background': background, 'text': text} %}</div>
        </div>

    </div>
</div>
