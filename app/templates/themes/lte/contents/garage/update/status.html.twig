
<div class="card border border-opacity-50 border-white border-1 shadow-sm {{ background }}">
    <div class="card-header border-bottom-0">
        {{ 'text.status'|trans|plural }}
    </div>
    <div class="card-body">
        <div class="row row-cols-4 g-3">
            <twig:UpdaterCheckbox
                entity="{{ entity.status }}"
                formulaire="{{ form.status.unblock }}"
            />
            <twig:UpdaterCheckbox
                entity="{{ entity.status }}"
                formulaire="{{ form.status.toUpgrade }}"
            />
            <twig:UpdaterCheckbox
                entity="{{ entity.status }}"
                formulaire="{{ form.status.gold }}"
            />
            <twig:UpdaterCheckbox
                entity="{{ entity.statusControl }}"
                formulaire="{{ form.statusControl.toGold }}"
            />
            <twig:UpdaterCheckbox
                entity="{{ entity.status }}"
                formulaire="{{ form.status.eventClass }}"
            />
            <twig:UpdaterCheckbox
                entity="{{ entity.status }}"
                formulaire="{{ form.status.evo }}"
            />
            <twig:UpdaterCheckbox
                entity="{{ entity.statusControl }}"
                formulaire="{{ form.statusControl.fullEvo }}"
            />
        </div>
    </div>
    <div class="card-header border-bottom-0">
        {{ 'text.full.blueprint'|trans|plural }}
    </div>
    <div class="card-body">
        <div class="row row-cols-3 g-3">
            <twig:UpdaterCheckbox
                entity="{{ entity.statusControl }}"
                formulaire="{{ form.statusControl.fullStar1 }}"
            />
            <twig:UpdaterCheckbox
                entity="{{ entity.statusControl }}"
                formulaire="{{ form.statusControl.fullStar2 }}"
            />
            <twig:UpdaterCheckbox
                entity="{{ entity.statusControl }}"
                formulaire="{{ form.statusControl.fullStar3 }}"
            />
            <twig:UpdaterCheckbox
                entity="{{ entity.statusControl }}"
                formulaire="{{ form.statusControl.fullStar4 }}"
            />
            <twig:UpdaterCheckbox
                entity="{{ entity.statusControl }}"
                formulaire="{{ form.statusControl.fullStar5 }}"
            />
            <twig:UpdaterCheckbox
                entity="{{ entity.statusControl }}"
                formulaire="{{ form.statusControl.fullStar6 }}"
            />
            <twig:UpdaterCheckbox
                entity="{{ entity.statusControl }}"
                formulaire="{{ form.statusControl.fullBlueprint }}"
            />
        </div>
    </div>
    <div class="card-header border-bottom-0">
        {{ 'text.to.install.import'|trans|plural }}
    </div>
    <div class="card-body">
        <div class="row row-cols-4 mb-3">
            <twig:UpdaterCheckbox
                entity="{{ entity.statusControl }}"
                formulaire="{{ form.statusControl.toInstallSpeed }}"
            />
            <twig:UpdaterCheckbox
                entity="{{ entity.statusControl }}"
                formulaire="{{ form.statusControl.toInstallAcceleration }}"
            />
            <twig:UpdaterCheckbox
                entity="{{ entity.statusControl }}"
                formulaire="{{ form.statusControl.toInstallHandling }}"
            />
            <twig:UpdaterCheckbox
                entity="{{ entity.statusControl }}"
                formulaire="{{ form.statusControl.toInstallNitro }}"
            />
        </div>
        <div class="row row-cols-3 mb-3">
            <twig:UpdaterCheckbox
                entity="{{ entity.statusControl }}"
                formulaire="{{ form.statusControl.toInstallCommon }}"
            />
            <twig:UpdaterCheckbox
                entity="{{ entity.statusControl }}"
                formulaire="{{ form.statusControl.toInstallRare }}"
            />
            <twig:UpdaterCheckbox
                entity="{{ entity.statusControl }}"
                formulaire="{{ form.statusControl.toInstallEpic }}"
            />
        </div>
        <div class="row row-cols-2 mb-3">
            <twig:UpdaterCheckbox
                entity="{{ entity.statusControl }}"
                formulaire="{{ form.statusControl.toInstallUpgrade }}"
            />
            <twig:UpdaterCheckbox
                entity="{{ entity.statusControl }}"
