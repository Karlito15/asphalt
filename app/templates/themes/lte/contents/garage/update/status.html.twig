
{% from "@App/themes/lte/contents/garage/_macros.html.twig" import getStars, getClass %}

<div class="card border border-opacity-25 border-white border-1 shadow-sm {{ background }}">
    <div class="card-header border-bottom-0 py-1 px-2 fs-1 poppins-black">{{ 'text.status'|trans }}</div>
    <div class="card-body py-1 px-2">
        <div class="row row-cols-5">
            <twig:FormCheckbox form="{{ form.status.unblock }}" />
            <twig:FormCheckbox form="{{ form.status.gold }}" />
            <twig:FormCheckbox form="{{ form.status.evo }}" />
            <twig:FormCheckbox form="{{ form.status.eventClass }}" />
            <twig:FormCheckbox form="{{ form.status.toUpgrade }}" />
        </div>
    </div>
</div>
