            />
        </div>
    </div>
    <div class="card-header border-bottom-0">
        {{ 'text.full.import'|trans|plural }}
    </div>
    <div class="card-body">
        <div class="row row-cols-4 mb-3">
            <twig:UpdaterCheckbox
                entity="{{ entity.statusControl }}"
