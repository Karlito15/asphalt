        <div class="row row-cols-2 mb-3">
            <twig:UpdaterCheckbox
                entity="{{ entity.statusControl }}"
                formulaire="{{ form.statusControl.fullUpgrade }}"
            />
            <twig:UpdaterCheckbox
                entity="{{ entity.statusControl }}"
                formulaire="{{ form.statusControl.fullImport }}"
            />
        </div>
    </div>
</div>
