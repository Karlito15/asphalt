{% macro getClass(setting, color) %}
    {% if setting.value == 'D' %}
    <i class="{{ icons.class.d }} {{ color }} fa-3x"></i>
    {% elseif setting.value == 'C' %}
    <i class="{{ icons.class.c }} {{ color }} fa-3x"></i>
    {% elseif setting.value == 'B' %}
    <i class="{{ icons.class.b }} {{ color }} fa-3x"></i>
    {% elseif setting.value == 'A' %}
    <i class="{{ icons.class.a }} {{ color }} fa-3x"></i>
    {% elseif setting.value == 'S' %}
    <i class="{{ icons.class.s }} {{ color }} fa-3x"></i>
    {% endif %}
{% endmacro %}
