
{% macro getBackgroundColor(status) %}
    {% set unblock = status.unblock %}
    {% set gold = status.gold %}
{% if unblock == false %}
    bg-danger-subtle
{% elseif unblock == true %}
    {% if unblock == true and gold == true %}
        bg-warning-subtle
    {% else %}
        bg-success-subtle
    {% endif %}
{% endif %}
{% endmacro %}

{% macro getTextColor(status) %}
    {% set gold = status.gold %}
    {% set unblock = status.unblock %}
    {% set toUpgrade = status.toUpgrade %}
{% if toUpgrade == false and unblock == false %}
    text-danger
{% elseif toUpgrade == false and unblock == true %}
    {% if gold == true %}
        text-warning
    {% else %}
        text-success
    {% endif %}
{% elseif toUpgrade == true %}
    text-primary
{% endif %}
{% endmacro %}

{% macro getStars(entity, color) %}
