
{% from "@App/themes/lte/contents/garage/_macros.html.twig" import getStars, getClass %}

<div class="card border border-opacity-25 border-white border-1 shadow-sm {{ background }}">
    <div class="card-header border-bottom-0 py-1 px-2 fs-1">{{ 'text.garage'|trans }}</div>
    <div class="card-body py-1 px-2">
        <table class="table table-striped table-bordered">
            <tr>
                <td class="w-25 py-1">{{ 'text.brand'|trans }}</td>
                <td class="w-25 py-1 {{ text }}">{{ entity.settingBrand.name }}</td>
                <td class="w-25 py-1">{{ 'text.game.update'|trans|u.truncate(4) }}</td>
                <td class="w-25 py-1">{{ entity.gameUpdate }}</td>
            </tr>
            <tr>
                <td class="w-25 py-1">{{ 'text.model'|trans }}</td>
                <td class="w-25 py-1 {{ text }}">{{ entity.model }}</td>
                <td class="w-25 py-1">{{ 'text.level'|trans }}</td>
                <td class="w-25 py-1">{{ entity.level }} / {{ entity.settingLevel.level }}</td>
            </tr>
            <tr>
                <td class="w-25 py-1">{{ 'text.class'|trans }}</td>
                <td class="w-25 py-1">{{ getClass(entity.settingClass, text)  }}</td>
                <td class="w-25 py-1">{{ 'text.epic'|trans }}</td>
                <td class="w-25 py-1">{{ entity.epic }} / {{ entity.settingLevel.epic }}</td>
            </tr>
            <tr>
                <td class="w-25 py-1">{{ 'text.stars'|trans }}</td>
                <td class="w-25 py-1">{{ getStars(entity, text)  }}</td>
                <td class="w-25 py-1">{{ 'text.order.class'|trans }}</td>
                <td class="w-25 py-1">{{ entity.carOrder }} / {{ entity.settingClass.carsNumber }}</td>
            </tr>
            <tr>
                <td class="w-25 py-1">{{ 'text.order.stat'|trans }}</td>
                <td class="w-25 py-1">{{ entity.statOrder }} / {{ entity.settingClass.carsNumber }}</td>
            </tr>
            {% if entity.status.evo == true %}
            <tr>
                <td class="w-25 py-1">{{ 'text.evo'|trans }}</td>
                <td class="w-25 py-1">{{ entity.evo }} / 24</td>
            </tr>
            {% endif %}
        </table>
    </div>
</div>
