
{% from "@App/themes/lte/contents/garage/_macros.html.twig" import getStars, getClass %}

<div class="card border border-opacity-50 border-white border-1 shadow-sm {{ background }}">
    <div class="card-body {{ text }}">
        <h1 class="display-5">{{ entity.settingBrand.name }}</h1>
        <h1 class="display-3">{{ entity.model }}</h1>
        <div class="row row-cols-2">
            <div class="col-2">
                <div class="info-box bg-transparent">
                    <div class="info-box-content">
                        <span class="info-box-text text-secondary">{{ 'text.class'|trans }}</span>
                        <span class="info-box-number">
                            {{ getClass(entity.settingClass, text)  }}
                        </span>
                    </div>
                </div>
            </div>
            <div class="col-10">
                <div class="info-box bg-transparent">
                    <div class="info-box-content">
                        <span class="info-box-text text-secondary">{{ 'text.stars'|trans }}</span>
                        <span class="info-box-number">
                            {{ getStars(entity, text)  }}
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
