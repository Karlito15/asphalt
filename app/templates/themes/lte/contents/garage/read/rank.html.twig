
<div class="card border border-opacity-50 border-white border-1 shadow-sm {{ background }}">
    <div class="card-header border-bottom-0 py-1 px-2">
        <i class="fa-solid fa-trophy"></i>&nbsp;{{ 'text.rank'|trans }}
    </div>
    <div class="card-body py-1 px-2">
        <table class="table table-striped table-bordered">
            <thead class="poppins-black">
                <tr>
                    <th class="text-start">{{ 'text.stars'|trans }}</th>
                    <th class="text-end">{{ 'text.rank'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="w-25 text-danger">
                        <span class="d-block d-lg-none"><i class="fa-solid fa-0"></i><i class="{{ icons.star.empty }}"></i></span>
                        <span class="d-none d-lg-block"><i class="{{ icons.star.empty }}"></i></span>
                    </td>
                    <td class="w-75 text-end">{{ entity.rank.star0 }}</td>
                </tr>
                <tr>
                    <td class="w-25 text-warning">
                        <span class="d-block d-lg-none"><i class="fa-solid fa-1"></i><i class="{{ icons.star.full }}"></i></span>
                        <span class="d-none d-lg-block"><i class="{{ icons.star.full }}"></i></span>
                    </td>
                    <td class="w-75 text-end">{{ entity.rank.star1 }}</td>
                </tr>
                <tr>
                    <td class="w-25 text-warning">
                        <span class="d-block d-lg-none"><i class="fa-solid fa-2"></i><i class="{{ icons.star.full }}"></i></span>
                        <span class="d-none d-lg-block">{% for i in 1..2 %}<i class="{{ icons.star.full }}"></i>{% endfor  %}</span>
                    </td>
                    <td class="w-75 text-end">{{ entity.rank.star2 }}</td>
                </tr>
                <tr>
                    <td class="w-25 text-warning">
                        <span class="d-block d-lg-none"><i class="fa-solid fa-3"></i><i class="{{ icons.star.full }}"></i></span>
                        <span class="d-none d-lg-block">{% for i in 1..3 %}<i class="{{ icons.star.full }}"></i>{% endfor  %}</span>
                    </td>
                    <td class="w-75 text-end">{{ entity.rank.star3 }}</td>
                </tr>
                {% if entity.stars >= 4 %}
                <tr>
                    <td class="w-25 text-warning">
                        <span class="d-block d-lg-none"><i class="fa-solid fa-4"></i><i class="{{ icons.star.full }}"></i></span>
                        <span class="d-none d-lg-block">{% for i in 1..4 %}<i class="{{ icons.star.full }}"></i>{% endfor  %}</span>
                    </td>
                    <td class="w-75 text-end">{{ entity.rank.star4 }}</td>
                </tr>
                {% endif %}
                {% if entity.stars >= 5 %}
                <tr>
                    <td class="w-25 text-warning">
                        <span class="d-block d-lg-none"><i class="fa-solid fa-5"></i><i class="{{ icons.star.full }}"></i></span>
                        <span class="d-none d-lg-block">{% for i in 1..5 %}<i class="{{ icons.star.full }}"></i>{% endfor  %}</span>
                    </td>
                    <td class="w-75 text-end">{{ entity.rank.star5 }}</td>
                </tr>
                {% endif %}
                {% if entity.stars >= 6 %}
                <tr>
                    <td class="w-25 text-warning">
                        <span class="d-block d-lg-none"><i class="fa-solid fa-6"></i><i class="{{ icons.star.full }}"></i></span>
                        <span class="d-none d-lg-block">{% for i in 1..6 %}<i class="{{ icons.star.full }}"></i>{% endfor  %}</span>
                    </td>
                    <td class="w-75 text-end">{{ entity.rank.star6 }}</td>
                </tr>
                {% endif %}
            </tbody>
        </table>
    </div>
</div>
