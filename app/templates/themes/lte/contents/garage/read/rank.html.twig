
<div class="card border border-opacity-25 border-white border-1 shadow-sm {{ background }}">
    <div class="card-header border-bottom-0 py-1 px-2 fs-1">{{ 'text.rank'|trans }}</div>
    <div class="card-body py-1 px-2">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>{{ 'text.stars'|trans }}</th>
                    <th>{{ 'text.rank'|trans }}</th>
                </tr>
            </thead>
            <tbody>
            <tr>
                <td class="w-25 py-1">{{ 'text.start'|trans }}</td>
                <td class="w-75 py-1 text-end">{{ entity.rank.star0 }}</td>
            </tr>
            <tr>
                <td class="w-25 py-1">{{ 'text.star1'|trans }}</td>
                <td class="w-75 py-1 text-end">{{ entity.rank.star1 }}</td>
            </tr>
            <tr>
                <td class="w-25 py-1">{{ 'text.star2'|trans }}</td>
                <td class="w-75 py-1 text-end">{{ entity.rank.star2 }}</td>
            </tr>
            <tr>
                <td class="w-25 py-1">{{ 'text.star3'|trans }}</td>
                <td class="w-75 py-1 text-end">{{ entity.rank.star3 }}</td>
            </tr>
            {% if entity.stars >= 4 %}
            <tr>
                <td class="w-25 py-1">{{ 'text.star4'|trans }}</td>
                <td class="w-75 py-1 text-end">{{ entity.rank.star4 }}</td>
            </tr>
            {% endif %}
            {% if entity.stars >= 5 %}
            <tr>
                <td class="w-25 py-1">{{ 'text.star5'|trans }}</td>
                <td class="w-75 py-1 text-end">{{ entity.rank.star5 }}</td>
            </tr>
            {% endif %}
            {% if entity.stars >= 6 %}
            <tr>
                <td class="w-25 py-1">{{ 'text.star6'|trans }}</td>
                <td class="w-75 py-1 text-end">{{ entity.rank.star6 }}</td>
            </tr>
            {% endif %}
            </tbody>
        </table>
    </div>
</div>
