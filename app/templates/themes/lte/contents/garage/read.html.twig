
{% extends '@App/themes/lte/bases/full.html.twig' %}

{% block body %} class="layout-fixed sidebar-expand-lg sidebar-mini sidebar-collapse reduce-motion app-loaded bg-body-tertiary"{% endblock %}

{% block content %}

    {% from "@App/themes/lte/contents/garage/_macros.html.twig" import getBackgroundColor, getTextColor %}

    {% set background, text = getBackgroundColor(entity.status)|u.toString|trim, getTextColor(entity.status)|u.toString|trim %}

{#    {{ dump(entity.statusControl) }}#}

    <div class="row row-cols-2 g-5 mb-5">
        <div class="col-7">{% include '@App/themes/lte/contents/garage/read/garage-1.html.twig' with {'background': background, 'text': text} %}</div>
        <div class="col-5">{% include '@App/themes/lte/contents/garage/read/garage-2.html.twig' with {'background': background, 'text': text} %}</div>
    </div>

    <div class="row row-cols-2 g-5 mb-5">
        <div class="col">{% include '@App/themes/lte/contents/garage/read/rank.html.twig' with {'background': background, 'text': text} %}</div>
        <div class="col">{% include '@App/themes/lte/contents/garage/read/stat.html.twig' with {'background': background, 'text': text} %}</div>
    </div>

    <div class="row row-cols-1 g-5 mb-5">
        <div class="col">{% include '@App/themes/lte/contents/garage/read/blueprint.html.twig' with {'background': background, 'text': text} %}</div>
        <div class="col">{% include '@App/themes/lte/contents/garage/read/upgrade.html.twig' with {'background': background, 'text': text} %}</div>
        <div class="col">{% include '@App/themes/lte/contents/garage/read/price.html.twig' with {'background': background, 'text': text} %}</div>
        <div class="col">{% include '@App/themes/lte/contents/garage/read/status.html.twig' with {'background': background, 'text': text} %}</div>
    </div>

{% endblock %}
