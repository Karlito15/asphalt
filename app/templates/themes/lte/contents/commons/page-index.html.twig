{% extends '@App/themes/lte/bases/full.html.twig' %}

{% block content %}

<div class="card bg-transparent">

    <div class="card-header">

        <div class="d-flex flex-row justify-content-between align-items-center">
            <div>
{#                <h2 class="h1">{{ controller_name }}</h2>#}
            </div>
        {% if current_page == 'app.garage.index' %}
            {# Garage #}
{#            <div class="datatable-toolbar">&nbsp;</div>#}
{#            <div>#}
{#                <a class="float-end btn btn-lg btn-outline-success text-uppercase" href="{{ path(links.create) }}">#}
{#                    {{ 'btn.create'|trans }}&nbsp;<i class="fa fa-plus-square"></i>#}
{#                </a>#}
{#            </div>#}
        {% elseif app.current_route starts with 'app.page' %}
            {# Pages #}
            <div>
                 <twig:ListClass link="{{ app.current_route }}" />
            </div>
        {% elseif app.current_route starts with 'app.search' %}
            {# Search #}
            <div>
                {% include '@App/themes/lte/contents/search/_form.html.twig' %}
            </div>
        {% endif %}

        </div>

    </div>

    <div class="card-body">
        <table class="table table-bordered table-striped"{% block tableId %}{% endblock %}>
            {% block table %}{% endblock %}
        </table>
    </div>

</div>

{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {% if app.environment == 'dev' %}
    <link rel="stylesheet" href="{{ asset('libraries/bootstrap-table/1.27/dist/bootstrap-table.css') }}">
    {% else %}
    <link rel="stylesheet" href="{{ asset('libraries/bootstrap-table/1.27/dist/bootstrap-table.min.css') }}">
    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('libraries/jquery/4.0.0.min.js') }}"></script>
    <!-- Scripts -->
    {% if app.environment == 'dev' %}
    <script src="{{ asset('libraries/bootstrap-table/1.27/dist/bootstrap-table.js') }}"></script>
    {% else %}
    <script src="{{ asset('libraries/bootstrap-table/1.27/dist/bootstrap-table.min.js') }}"></script>
    {% endif %}
    <script>
        const $table        = $('#Garage');
        const GarageColumns = [];
        console.warn($table);
        function initTable () {
            $table.bootstrapTable({
                locale: 'en-US',
                // locale: 'fr-FR',
                columns: GarageColumns,
                buttonsAlign: 'end',

                cache: false,

                icons: {
                    paginationSwitchDown: 'fa-caret-square-down',
                    paginationSwitchUp: 'fa-caret-square-up',
                    refresh: 'fa-sync',
                    toggleOff: 'fa-toggle-off',
                    toggleOn: 'fa-toggle-on',
                    columns: 'fa-th-list',
                    fullscreen: 'fa-arrows-alt',
                    detailOpen: 'fa-plus',
                    detailClose: 'fa-minus'
                },
                iconSize: 'sm',
                iconsPrefix: 'fa',

                pageList: [20, 40, 60, 80, 100, 'all'],
                pageSize: 15,
                pagination: true,
                paginationHAlign: 'end',
                paginationVAlign: 'bottom',
                paginationLoop: true,

                search: true,
                searchAlign: 'start',
                searchAccentNeutralise: true,
                searchHighlight: true,
                searchTimeOut: 200,
                visibleSearch: false,

                silentSort: false,

                showButtonIcons: true,
                showButtonText: false,
                showColumns: true,
                showColumnsSearch: true,
                showColumnsToggleAll: true,
                showExtendedPagination: true,
                showFullscreen: false,
                showPaginationSwitch: true,
                showSearchButton: false,
                showSearchClearButton: true,
            })
        }
        // Start
        initTable();

    </script>
{% endblock %}
