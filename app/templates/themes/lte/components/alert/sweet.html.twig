<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.24/dist/sweetalert2.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.24/dist/sweetalert2.all.min.js"></script>

<div{{ attributes }} id="flash-messages">
    <!-- component HTML -->
</div>

<script>
Swal.fire({
    animation: true,
    draggable: false,
    focusConfirm: false,
    icon: "{{ type }}",
    position: "top-end",
    showCancelButton: false,
    showCloseButton: false,
    showConfirmButton: false,
    showDenyButton: false,
    // text: "",
    theme: 'dark',
    timer: 3000,
    timerProgressBar: true,
    title: "{{ message }}",
    toast: true,
    topLayer: true,
    width: '33%',
    didOpen: (toast) => {
        toast.onmouseenter = Swal.stopTimer;
        toast.onmouseleave = Swal.resumeTimer;
    }
});
</script>
