
<div class="col"{{ attributes }}>
    <!-- component HTML -->
    {{ form_label(formulaire) }}
    {{ form_widget(formulaire, {'label_attr': {'class': _self.color(formulaire.vars.data, formulaire.vars.name)}}) }}
</div>

{% macro color(value, name) %}
{% if (value is true) and (name == 'gold') %}
btn btn-outline-warning w-100
{% elseif (value is true) and (name == 'toUpgrade') %}
btn btn-outline-primary w-100
{% elseif value is true %}
btn btn-outline-success w-100
{% else %}
btn btn-outline-danger w-100
{% endif %}
{% endmacro %}
