<div class="col"{#{{ attributes }}#}>
    <!-- component HTML -->
    {{ form_widget(form, {'label_attr': {'class': _self.color(form.vars.data, form.vars.name)}}) }}
    {{ form_label(form) }}
{#    {{ form_help(form) }}#}
{#    {{ form_errors(form) }}#}
</div>

{% macro color(value, name) %}
{% if (value is true) and (name == 'gold') %}
w-100 btn btn-outline-warning
{% elseif (value is true) and (name == 'toUpgrade') %}
w-100 btn btn-outline-primary
{% elseif value is true %}
w-100 btn btn-outline-success
{% else %}
w-100 btn btn-outline-danger
{% endif %}
{% endmacro %}
