
{# background #}
    {% set background = 'primary' %}

{# percent #}
{#{% set percent = (form.vars.value.value / maxValue * 100) %}#}
{#{{ dump(percent) }}#}

<div class="col">

    <!--begin::info-box-->
    <div class="info-box"{{ attributes }}>
        <span class="info-box-icon text-bg-{{ background }} shadow-sm">
            <form action="" method="post" class="d-flex">
                <label for="{{ this.label() }}"></label>
                <input
                    type="text"
                    name="{{ this.slug() }}"
                    id="{{ this.label() }}"
                    class="form-control-plaintext fw-bolder text-center align-items-center"
                    autocomplete="off"
                    autocapitalize="none"
                    max="{{ maxValue }}"
                    min="{{ 0 }}"
                    maxlength="2"
                    minlength="0"
                    placeholder=""
                    tabindex="{{ this.position() }}"
                    value="{{ this.value() }}"
                    hx-post=""{# {{ path('ajax.dashboard.inventory') }} #}
                    hx-target="#flash-messages"
                    hx-trigger="change"
                >
            </form>
        </span>
        <div class="info-box-content">
            <span class="info-box-text fs-5 fw-bold">{{this.letter()|raw}} {{this.star()|raw}}</span>
            <span class="info-box-number">10<small>%</small></span>
        </div>
    </div>
    <!--end::info-box-->

</div>
