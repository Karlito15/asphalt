{# FORM CLASS #}
{% set formClass = form.vars.attr.class ~ ' bg-secondary-subtle text-secondary' %}

{# INPUT CLASS #}
{% if this.rest() is defined and this.rest() == 0 %}
    {% set inputClass = form.vars.attr.class ~ ' bg-success-subtle text-success' %}
{% elseif this.rest() is defined and this.value() > 0 %}
    {% set inputClass = form.vars.attr.class ~ ' bg-primary-subtle text-primary' %}
{% else %}
    {% set inputClass = form.vars.attr.class ~ ' bg-danger-subtle text-danger' %}
{% endif %}

{# RESULT #}
{% if value == 'Done' or value == 'None' %}
    {% set result = 0 %}
{% else %}
    {% set result = (this.rest() / games.pack_blueprint)|round(0, 'ceil') %}
{% endif %}

<div class="col-2"{# attributes #}>
    <!-- component HTML -->
    <div class="text-center">{{ form_label(form) }}</div>
    <div class="input-group mb-2">
        {{ form_widget(form, {
            'attr': {
                'class': inputClass,
                'max': this.target(),
                'min': form.vars.attr.min,
            }
        }) }}
        <span class="input-group-text justify-content-center {{ inputClass }}" id="{{ form.vars.id }}">{{ this.rest() }}</span>
        <span class="input-group-text justify-content-center {{ formClass }}" id="{{ form.vars.id }}">{{ this.target() }}</span>
        {{ form_help(form) }}
        {{ form_errors(form) }}
    </div>

    <div class="input-group input-group-sm">
        <input
            type="text"
            id="blueprints"
            class="text-center text-info form-control"
            value="{{ (result * games.pack_price)|abs|number_format }} {{ 'text.token'|trans|plural|u.truncate(2, '.') }}"
            disabled
        />
        <label for="blueprints"></label>
        <label for="packs"></label>
        <input
            type="text"
            id="packs"
            class="text-center text-success form-control"
            value="{{ result|abs }} {{ 'text.pack'|trans|plural }}"
            disabled
        />
    </div>
</div>
